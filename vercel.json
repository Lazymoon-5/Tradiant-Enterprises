{
  "version": 2,
  "builds": [
    {
      "src": "*.php",
      "use": "vercel-php@0.7.1"
    },
    {
      "src": "pages/**/*.php",
      "use": "vercel-php@0.7.1"
    },
    {
      "src": "admin/**/*.php",
      "use": "vercel-php@0.7.1"
    },
    {
      "src": "api/**/*.php",
      "use": "vercel-php@0.7.1"
    }
  ],
  "routes": [
    {
      "src": "/admin/login/?$",
      "dest": "/admin/login.php"
    },
    {
      "src": "/admin/?$",
      "dest": "/admin/login.php"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
